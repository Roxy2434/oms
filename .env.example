# Không bắt buộc. Muốn đổi mật khẩu mặc định: sao chép file này thành .env, bỏ dấu # và điền.
# Đổi DB_PASSWORD sau khi đã chạy lần đầu thì phải chạy `docker compose down -v` để tạo lại DB.

# DB_PASSWORD=oms-demo-db-2026
# SESSION_SECRET=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# BOOTSTRAP_PASSWORD=OmsDemo@2026

# ShopVui: mỗi tài khoản đăng ký mới nhận 6.000.000đ ví MÔ PHỎNG một lần trên server.
# Chuyển khoản SePay là tiền THẬT, tách biệt ví mô phỏng. Không có nút tự xác nhận.
# Chỉ bật sau khi cấu hình đúng tài khoản nhận tiền và kiểm tra HTTPS/origin khi deploy.
# Safe default for demos: real bank payments disabled, even if bank credentials are present.
OMS_DEMO_MODE=1
# SEPAY_API_TOKEN=
# SEPAY_ACCOUNT=
# SEPAY_BANK=970422
# SEPAY_HOLDER=
# SEPAY_POLL=on
# APP_ORIGIN=http://127.0.0.1:3001
# SHOPVUI_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
