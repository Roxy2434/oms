<bpmndi:BPMNShape id="waitStock_di" bpmnElement="waitStock"><dc:Bounds x="640" y="100" width="190" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="waitEnd_di" bpmnElement="waitEnd"><dc:Bounds x="900" y="125" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="fulfill_di" bpmnElement="fulfill" isExpanded="false"><dc:Bounds x="640" y="270" width="190" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="slaBoundary_di" bpmnElement="slaBoundary"><dc:Bounds x="790" y="337" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="slaException_di" bpmnElement="slaException"><dc:Bounds x="880" y="455" width="200" height="70"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="slaEnd_di" bpmnElement="slaEnd"><dc:Bounds x="1150" y="472" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="deliveryGateway_di" bpmnElement="deliveryGateway"><dc:Bounds x="950" y="280" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="doneEnd_di" bpmnElement="doneEnd"><dc:Bounds x="1120" y="245" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="retryGateway_di" bpmnElement="retryGateway"><dc:Bounds x="1120" y="360" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="retryRecord_di" bpmnElement="retryRecord"><dc:Bounds x="1350" y="260" width="200" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="openReturn_di" bpmnElement="openReturn"><dc:Bounds x="1350" y="390" width="200" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="returnEnd_di" bpmnElement="returnEnd"><dc:Bounds x="1630" y="412" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="RMA_Pool_di" bpmnElement="RMA_Pool"><dc:Bounds x="80" y="620" width="1800" height="450"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="rmaStart_di" bpmnElement="rmaStart"><dc:Bounds x="160" y="700" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="rmaOpen_di" bpmnElement="rmaOpen"><dc:Bounds x="240" y="675" width="160" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="receive_di" bpmnElement="receive"><dc:Bounds x="440" y="675" width="160" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="qc_di" bpmnElement="qc"><dc:Bounds x="640" y="675" width="160" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="disposition_di" bpmnElement="disposition"><dc:Bounds x="840" y="675" width="180" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="claimGateway_di" bpmnElement="claimGateway"><dc:Bounds x="1060" y="695" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="claim_di" bpmnElement="claim"><dc:Bounds x="1180" y="675" width="190" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="claimJoin_di" bpmnElement="claimJoin"><dc:Bounds x="1430" y="695" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="existingFinance_di" bpmnElement="existingFinance"><dc:Bounds x="1220" y="880" width="220" height="85"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="closeGateway_di" bpmnElement="closeGateway"><dc:Bounds x="1500" y="895" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="waitReconcile_di" bpmnElement="waitReconcile"><dc:Bounds x="1580" y="780" width="210" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="rmaEnd_di" bpmnElement="rmaEnd"><dc:Bounds x="1680" y="900" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="d1_di" bpmnElement="d1"><di:waypoint x="196" y="143"/><di:waypoint x="260" y="142.5"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d2_di" bpmnElement="d2"><di:waypoint x="440" y="142.5"/><di:waypoint x="500" y="145"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d3_di" bpmnElement="d3"><di:waypoint x="550" y="145"/><di:waypoint x="640" y="312.5"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d4_di" bpmnElement="d4"><di:waypoint x="550" y="145"/><di:waypoint x="640" y="142.5"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d5_di" bpmnElement="d5"><di:waypoint x="830" y="142.5"/><di:waypoint x="900" y="143"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d6_di" bpmnElement="d6"><di:waypoint x="830" y="312.5"/><di:waypoint x="950" y="305"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d7_di" bpmnElement="d7"><di:waypoint x="1000" y="305"/><di:waypoint x="1120" y="263"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d8_di" bpmnElement="d8"><di:waypoint x="1000" y="305"/><di:waypoint x="1120" y="385"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d9_di" bpmnElement="d9"><di:waypoint x="826" y="355"/><di:waypoint x="880" y="490"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d10_di" bpmnElement="d10"><di:waypoint x="1080" y="490"/><di:waypoint x="1150" y="490"/></bpmndi:BPMNEdge>
