<bpmndi:BPMNEdge id="r9_di" bpmnElement="r9"><di:waypoint x="1480" y="720"/><di:waypoint x="1220" y="922.5"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="r10_di" bpmnElement="r10"><di:waypoint x="1440" y="922.5"/><di:waypoint x="1500" y="920"/></bpmndi:BPMNEdge>
