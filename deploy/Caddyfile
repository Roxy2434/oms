{
 admin off
 email {$ACME_EMAIL}
}
http://127.0.0.1:2020 {
 respond /healthz "edge ready" 200
}
{$DOMAIN} {
 encode zstd gzip
 header {
  -Server
  X-Content-Type-Options nosniff
  X-Frame-Options DENY
  Referrer-Policy no-referrer
  Strict-Transport-Security "max-age=31536000"
  Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Permissions-Policy "camera=(), microphone=(), geolocation=()"
 }
 request_body {
  max_size 8MB
 }
 handle /healthz {
  rewrite * /api/health
  reverse_proxy backend:3001 {
   header_up X-Real-IP {remote_host}
  }
 }
 @buyer path /api/storefront/* /api/integrations/shopvui/*
 handle @buyer {
  reverse_proxy backend:3001 {
   header_up X-Real-IP {remote_host}
   header_up -Forwarded
  }
 }
 @staff not path / /index.html /assets/* /favicon.ico /robots.txt
 handle @staff {
  basic_auth {
   {$STAFF_EDGE_USER} {$STAFF_EDGE_HASH}
  }
  reverse_proxy backend:3001 {
   header_up X-Real-IP {remote_host}
  }
 }
 handle {
  root * /srv
  @staticImg path /assets/images/*
  header @staticImg Cache-Control "public, max-age=86400"
  @notImg not path /assets/images/*
  header @notImg Cache-Control "no-cache"
  file_server
 }
}
