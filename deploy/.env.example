# Generate private deploy/.env with python deploy/init-env.py --domain YOUR.DOMAIN --email YOUR.EMAIL
DOMAIN=
ACME_EMAIL=
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=
SESSION_SECRET=
BOOTSTRAP_PASSWORD=
STAFF_EDGE_USER=operator
STAFF_EDGE_HASH=
# Classroom hardening: queues concurrent Argon2 logins & widens per-IP NAT limits for shared school Wi-Fi.
OMS_CLASSROOM_MODE=1
OMS_DISABLE_CAPTCHA=0
# Free Cloudflare Turnstile widget; never use test keys on a public domain (or set OMS_DISABLE_CAPTCHA=1 for classroom).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=
# Mixed demo: COD/wallet simulated; SePay real ONLY after explicit opt-in/configuration.
OMS_DEMO_REAL_BANK=0
SEPAY_API_TOKEN=
SEPAY_ACCOUNT=
SEPAY_BANK=970422
SEPAY_HOLDER=
SEPAY_REFUND_CONTACT=
# Latest ID reconciled at initial cutover. Not a pagination page number.
SEPAY_START_ID=
# Optional endpoint receiving POST form event=...; secret URL stays private.
OPS_ALERT_URL=
