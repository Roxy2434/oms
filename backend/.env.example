# Local host DB port; if changed, update both URL ports below too.
OMS_DB_PORT=55432
DB_PASSWORD=replace-with-random-secret
DATABASE_URL=postgresql://oms:replace-with-random-secret@127.0.0.1:55432/oms
TEST_DATABASE_URL=postgresql://oms:replace-with-random-secret@127.0.0.1:55432/oms_test
SESSION_SECRET=replace-with-32-byte-random-secret
BOOTSTRAP_PASSWORD=replace-with-strong-password
APP_ORIGIN=http://127.0.0.1:3001
SHOPVUI_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
# Safe default: repeatable demo, no real incoming bank transfers or QR.
OMS_DEMO_MODE=1
# Set OMS_DEMO_MODE=0 only after approving real-money deployment.
# Optional real incoming bank transfers. Wallet credit is simulated and cannot be withdrawn.
SEPAY_API_TOKEN=
SEPAY_ACCOUNT=
SEPAY_BANK=970422
SEPAY_HOLDER=
SEPAY_POLL=on
